import json
import time


def register_resources(mcp):
    @mcp.resource("info://server")
    def server_info() -> str:
        """Information about this MCP server."""
        return json.dumps(
            {
                "name": "{{name}}",
                "version": "0.1.0",
                "uptime": time.monotonic(),
            },
            indent=2,
        )
