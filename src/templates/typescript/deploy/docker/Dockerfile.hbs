FROM node:22-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/build ./build
{{#if (eq transport "stdio")}}
ENTRYPOINT ["node", "build/index.js"]
{{else}}
EXPOSE 3000
CMD ["node", "build/index.js"]
{{/if}}
