import { createRemoteJWKSet, jwtVerify } from "jose";
import type { Request, Response, NextFunction } from "express";

// OAuth 2.1 token validation middleware for MCP servers
// Per the MCP 2025-11-25 spec, HTTP-based MCP servers SHOULD support OAuth 2.1
// for authentication. This middleware validates JWT Bearer tokens using JWKS.
//
// Required environment variables:
//   OAUTH_ISSUER_URL - The OAuth issuer URL (e.g. https://accounts.google.com)
//   OAUTH_AUDIENCE   - The expected audience claim

const issuerUrl = process.env.OAUTH_ISSUER_URL;
const audience = process.env.OAUTH_AUDIENCE;

if (!issuerUrl || !audience) {
  console.error(
    "Missing OAUTH_ISSUER_URL or OAUTH_AUDIENCE environment variables"
  );
  process.exit(1);
}

const jwksUrl = new URL("/.well-known/jwks.json", issuerUrl);
const JWKS = createRemoteJWKSet(jwksUrl);

export async function validateOAuthToken(
  req: Request,
  res: Response,
  next: NextFunction
): Promise<void> {
  const authHeader = req.headers.authorization;
  if (!authHeader?.startsWith("Bearer ")) {
    res.status(401).json({ error: "Missing or invalid Authorization header" });
    return;
  }

  const token = authHeader.slice(7);

  try {
    const { payload } = await jwtVerify(token, JWKS, {
      issuer: issuerUrl,
      audience,
    });

    // Attach the decoded token to the request for downstream use
    (req as Request & { auth?: unknown }).auth = payload;
    next();
  } catch (err) {
    res.status(401).json({ error: "Invalid or expired token" });
  }
}
